# ---------------------------------------------------------------------------
# GIWA network — all values from https://docs.giwa.io/get-started/connect-to-giwa.md
# ---------------------------------------------------------------------------
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_SEPOLIA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io

# Blockscout verification — https://docs.giwa.io/get-started/smart-contract/develop/foundry.md
BLOCKSCOUT_API_URL=https://sepolia-explorer.giwa.io/api
BLOCKSCOUT_API_KEY=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Owner of the deployed contracts (a multisig in production). Defaults to the deployer.
PROTOCOL_OWNER=

# There is no mock mode. Identity always resolves against the live DojangScroll and the live
# UPNameRegistry; the deploy script reverts if either has no code on the target chain.
# A wallet gets its own real Verified Address attestation ("Dojang 발급") and its own
# username.up.id at https://sepolia-playground.giwa.io/ before it can register as an employer.
#
# ATTESTER_MODE: "faucet" (GIWA TESTNET FAUCET attester — obtainable on GIWA Sepolia)
#                "upbit"  (Upbit Korea KYC attester — production)
ATTESTER_MODE=faucet

# Address of the deployer account, used by `make deploy-testnet-dry` to simulate.
DEPLOYER_ADDRESS=

# Optional overrides — only for deploying onto an anvil FORK of GIWA, which carries the same
# real contracts. Leave unset to use the documented addresses in src/GiwaConstants.sol.
# DOJANG_SCROLL=
# UP_NAME_REGISTRY=

# Import the deployer key once with:  cast wallet import deployer --interactive
# then pass --account deployer to forge script (never put a raw key in this file).
